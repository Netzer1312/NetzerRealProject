<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEFF1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/meow_meow"
            android:contentDescription="Logo Image" />

        <EditText
            android:id="@+id/UserNameR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Name"
            android:background="@android:drawable/edit_text"
            android:inputType="textPersonName"
            android:textSize="18sp"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/UserEmailR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:background="@android:drawable/edit_text"
            android:inputType="textEmailAddress"
            android:textSize="18sp"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/UserPasswordR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:background="@android:drawable/edit_text"
            android:inputType="textPassword"
            android:textSize="18sp"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/UserPasswordC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Confirm Password"
            android:background="@android:drawable/edit_text"
            android:inputType="textPassword"
            android:textSize="18sp"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/UserPhoneR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:background="@android:drawable/edit_text"
            android:inputType="phone"
            android:textSize="18sp"
            android:padding="14dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btToGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3F51B5"
            android:elevation="4dp"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btToLogIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already registered? Log in →"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:backgroundTint="#FFFFFF"
            android:elevation="2dp"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
